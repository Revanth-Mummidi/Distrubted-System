# Copy this file to .env before running `docker-compose up --build`

# Gateway JWT signing secret
JWT_SECRET=super_secret_jwt_key_12345

# Google OAuth — get this from https://console.cloud.google.com/
# Create an OAuth 2.0 Client ID (Web application), add http://localhost:5173 as
# an Authorised JavaScript Origin, then paste the Client ID here.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Same value — needed by Vite at frontend build time
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# PostgreSQL password (docker-compose creates the DB automatically)
POSTGRES_PASSWORD=arena_pass

# Optional overrides (docker-compose already wires these inside the stack):
# REDIS_HOST=redis
# REDIS_PORT=6379
