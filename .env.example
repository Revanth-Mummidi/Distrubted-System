# Copy this file to .env before running `docker-compose up --build`
# (or set these in your shell environment).

# Gateway — used to sign and verify JWTs issued by /auth/login.
JWT_SECRET=super_secret_jwt_key_12345

# Optional overrides (the docker-compose file already wires these for you):
# REDIS_HOST=redis
# REDIS_PORT=6379
# GATEWAY_PORT=3000
# INGESTION_PORT=3001
# STATUS_PORT=3002
